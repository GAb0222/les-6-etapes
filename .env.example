APP_ENV=local
APP_PORT=8089
DATA_BACKEND=json

# Identifiants admin (ne jamais committer .env)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Équipe Apple Developer (signature + universal links)
APPLE_TEAM_ID=74S43YQ863
# Clé API App Store Connect (ne pas committer la clé .p8)
ASC_ISSUER_ID=
ASC_KEY_ID=

# Port MariaDB exposé sur le HOST (l'app s'y connecte en interne sur le port 3306)
DB_PORT=3307
DB_NAME=pedagogic_game
DB_USER=pedagogic_user
DB_PASSWORD=pedagogic_password
DB_ROOT_PASSWORD=root_password

# Mailpit — interface web de capture des emails (local uniquement)
MAILPIT_UI_PORT=8025

# Profil optionnel : docker compose --profile tools up
PHPMYADMIN_PORT=8081
